ORK/1.0
NAME TOTE_DATABASE_POPULATION_MESH
MODE LIVE_INSTANCE
BONIT "TOTElibrary.bonit"

# Migration note: as of the .ork/.bonit reconciliation, this file carries
# ONLY the invariant step-marker/loop-control header. All protocol content
# (authority roles, workflow steps, validation rules, submission format,
# etc.) moved to ./TOTElibrary.bonit, named above, unchanged in substance.
# This header is the per-run template: PATH starts at the protocol's first
# step; a real in-flight run rewrites PATH/LAST_WRITER/WRITTEN_AT/MARKER as
# it advances through TOTElibrary.bonit's WORKFLOW.

POSITION {
  PATH [
    {STEP 1, LABEL "assign_batch", ITER null, MAX_ITERATIONS null, EXIT_PREDICATE_REF null, ON_BOUND_EXCEEDED null}
  ]
  LAST_WRITER "nx-001"
  WRITTEN_AT null
  MARKER 0
}
