      "loop_id": "trade.carpentry.drive_nail_flush.v1",
      "behavior_id": "trade.carpentry.drive_nail_flush",
      "version": 1,
      "status": "CANDIDATE",
      "supersedes": null,
      "name": "Drive a nail flush",
      "domain": "trade-carpentry",
      "objective": "Drive a nail straight until its head is flush with the surface.",
      "initial_test": "Look at the nail: head height above the surface.",
      "exit_predicate": "The head is flush with the surface, the nail is straight, and the wood around it is not marred.",
      "max_iterations": 12,
      "epistemic_status": "EXPERIMENTAL",
      "source_basis": "O*NET-SOC 47-2031.00 Carpenters; occupation reference only. Steps machine-drafted by Claude (claude-opus-5-5) on 2026-09-29; not observed or verified.",
      "verification_tier": "MACHINE_DRAFTED",
      "gestalts": [
        "hammer",
        "flush"
      ],
      "steps": [
        {
          "id": "look",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look at the nail head: how far above the surface?"
        },
        {
          "id": "compare",
          "phase": "TEST",
          "op": "internal_model",
          "sense": "visual",
          "text": "Compare with a flush head.",
          "on_match": "exit"
        },
        {
          "id": "strike",
          "phase": "OPERATE",
          "op": "execute",
          "sense": "kinesthetic",
          "text": "Strike square to the head, swinging from the elbow."
        },
        {
          "id": "hear",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "auditory",
          "text": "Listen: solid strike or glancing?",
          "on_mismatch": "check_bend"
        },
        {
          "id": "see",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look at the head height.",
          "on_match": "exit",
          "on_mismatch": "check_bend"
        },
        {
          "id": "check_bend",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look: is the nail bent or leaning?",
          "on_match": "look",
          "on_mismatch": "straighten"
        },
        {
          "id": "straighten",
          "phase": "OPERATE",
          "op": "execute",
          "sense": "kinesthetic",
          "text": "Tap the shank back upright from the side, or pull the nail if badly bent."
        },
        {
          "id": "see_straight",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look: nail upright.",
          "on_match": "look",
          "on_mismatch": "straighten"
        },
        {
          "id": "exit",
          "phase": "EXIT",
          "op": null,
          "sense": "none",
          "text": "The head is flush with the surface, the nail is straight, and the wood around it is not marred.",
          "on_mismatch": "strike"
        }
      ]
    },
