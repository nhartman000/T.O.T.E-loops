      "steps": [
        {
          "id": "look",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look at the ground (level, firm) and the top contact point, and for overhead power lines.",
          "on_mismatch": "relocate"
