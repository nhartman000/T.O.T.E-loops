        {
          "id": "see_locks",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look: both locks hooked over rungs.",
          "on_mismatch": "raise"
        },
        {
          "id": "angle",
          "phase": "OPERATE",
          "op": "execute",
          "sense": "kinesthetic",
          "text": "Set the base about 1 ft out per 4 ft of height."
        },
        {
          "id": "check_angle",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "kinesthetic",
          "text": "Stand at the base, toes on the rails, arms straight: palms reach the rung?",
          "on_mismatch": "angle"
