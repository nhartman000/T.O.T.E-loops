          "on_mismatch": "level"
        },
        {
          "id": "relocate",
          "phase": "OPERATE",
          "op": "execute",
          "sense": "kinesthetic",
          "text": "Choose another spot away from hazards."
        },
        {
          "id": "see_relocate",
