      "loop_id": "trade.general.read_tape.v1",
      "behavior_id": "trade.general.read_tape",
      "version": 1,
      "status": "CANDIDATE",
      "supersedes": null,
      "name": "Read a tape measure",
      "domain": "trade-general",
      "objective": "Read a length to the nearest 1/16 inch.",
      "initial_test": "Look at the tape where it meets the edge.",
      "exit_predicate": "The reading, spoken as inches and fraction, is the same on a second reading.",
      "max_iterations": 3,
      "epistemic_status": "EXPERIMENTAL",
      "source_basis": "O*NET-SOC 47-2061.00 Construction Laborers; occupation reference only. Steps machine-drafted by Claude (claude-opus-5-5) on 2026-09-29; not observed or verified.",
      "verification_tier": "MACHINE_DRAFTED",
      "gestalts": [
        "measure"
      ],
      "steps": [
        {
          "id": "look",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Look at where the tape meets the edge."
        },
        {
          "id": "inch",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Read the last full inch number."
        },
        {
          "id": "fraction",
          "phase": "OPERATE",
          "op": "internal_model",
          "sense": "visual",
          "text": "Count the marks past the inch by length: longest is 1/2, then 1/4, 1/8, 1/16."
        },
        {
          "id": "say",
          "phase": "OPERATE",
          "op": "operative_intent",
          "sense": "internal",
          "text": "State the reading as inches plus fraction."
        },
        {
          "id": "write",
          "phase": "OPERATE",
          "op": "execute",
          "sense": "kinesthetic",
          "text": "Write the number down."
        },
        {
          "id": "reread",
          "phase": "TEST",
          "op": "external_observe",
          "sense": "visual",
          "text": "Read the tape again and compare to what was written.",
          "on_match": "exit",
          "on_mismatch": "fraction"
        },
        {
          "id": "exit",
          "phase": "EXIT",
          "op": null,
          "sense": "none",
          "text": "The reading, spoken as inches and fraction, is the same on a second reading.",
          "on_mismatch": "look"
        }
      ]
    },
